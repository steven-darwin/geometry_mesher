{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/geometry_mesher",
      "installDir": "${sourceDir}/../../install/geometry_mesher",
        "cacheVariables": {
            "CMAKE_C_COMPILER": "cl.exe",
            "CMAKE_CXX_COMPILER": "cl.exe",
            "VCPKG_INSTALLED_DIR": "${sourceDir}/lib/vcpkg_installed",
            "VCPKG_MANIFEST_DIR": "${sourceDir}/lib",
            "VCPKG_MANIFEST_MODE": "ON",
            "VCPKG_MANIFEST_INSTALL": "ON"
        },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "hidden": true,
      "name": "vcpkg",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ]
}
